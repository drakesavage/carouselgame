# Copy to .env and adjust. .env is git-ignored. No API keys are needed: the GM runs through the Codex CLI.

# codex (default), gemini or mock
GM_PROVIDER=codex
# Blank = whatever model your Codex config defaults to
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_S=240
# Gemini (GM_PROVIDER=gemini): key from GEMINI_API_KEY, or a git-ignored data\gemini_api_key.txt / .\gemini_api_key.txt
# Free-tier inputs and outputs may be used by Google to improve its products.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: character budgets for the GM briefing (see backend/app/memory/context.py DEFAULT_BUDGET)
# CONTEXT_BUDGETS={"present_each": 3200, "companion": 4200}
# Optional: where temporary GM job folders go (default data\codex_jobs; not under LocalAppData, which Codex 0.163 rejects)
# CODEX_JOBS_DIR=
# Optional: pin the Codex binary (otherwise the Codex desktop app's newest build or `codex` on PATH)
# CODEX_BIN=C:\path\to\codex.exe

# Local rulebook PDFs (indexed into data/rulebooks.db; never copied, never committed)
RULEBOOK_DIR=C:\Users\you\Downloads\DCC Rulebooks
# Read-only source for the campaign importer
CAMPAIGN_LEDGER_DIR=E:\dccrpg\campaign_sources\dccrepository
# Optional: fixed token for the GM-only API (/api/gm); otherwise generated into data\gm_token.txt
# GM_TOKEN=
